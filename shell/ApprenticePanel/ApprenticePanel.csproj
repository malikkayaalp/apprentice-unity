<Project Sdk="Microsoft.NET.Sdk">

  <!-- Apprentice Panel kabugu: panel.html'i WebView2 ile KENDI penceresinde acar.
       Tarayici degil, gercek uygulama: kendi ikonu, kendi gorev cubugu kimligi, port
       gorunmez. Arayuz kodu (clients/web/panel.html) DEGISMEZ - yalnizca kabuk. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Apprentice-Panel</AssemblyName>
    <RootNamespace>Apprentice</RootNamespace>
    <ApplicationIcon>..\..\assets\apprentice.ico</ApplicationIcon>
    <Version>0.3.0</Version>
    <Company>Apprentice</Company>
    <Product>Apprentice Panel</Product>
    <AssemblyTitle>Apprentice Panel</AssemblyTitle>
    <Description>Yerel model calisir, frontier model denetler - canli panel</Description>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <PublishReadyToRun>true</PublishReadyToRun>   <!-- daha hizli acilis -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2792.45" />
  </ItemGroup>

</Project>
